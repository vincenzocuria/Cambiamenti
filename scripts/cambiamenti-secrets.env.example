# Copia in scripts/cambiamenti-secrets.env (non committare).

# Resend / SMTP Auth Supabase (sblocca template custom sul piano free)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_INCOLLA_API_KEY
SMTP_ADMIN_EMAIL=no-reply@vcuria.app
SMTP_SENDER_NAME=Cambia-Menti Formazione
RATE_LIMIT_EMAIL_SENT=30

# Cron giornaliero check-doc-expiry (Cloudflare Worker + Supabase Edge Function)
# OBBLIGATORIO: genera una stringa casuale lunga e sicura
# CRON_SECRET=genera_una_stringa_lunga_casuale

# OBBLIGATORIO: email dei superadmin autorizzati (separati da virgola)
# Esempio: admin@example.com,superadmin@example.com
# SUPERADMIN_EMAILS=

# OBBLIGATORIO: origini CORS consentite per edge functions (separati da virgola)
# Esempio: https://cambiamenti.vcuria.app,http://localhost:5173
# ALLOWED_CORS_ORIGINS=

# Opzionale
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=oevppwtjbzbopjvsvoiu
