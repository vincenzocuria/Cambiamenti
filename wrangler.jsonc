{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cambiamenti",
  "compatibility_date": "2026-08-07",
  // SPA statica: frontend Vite+React, backend su Supabase
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "cambiamenti.vcuria.app", "custom_domain": true }
  ]
}
