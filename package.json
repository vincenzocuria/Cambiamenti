{
  "name": "vcuria-gestionale",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/cleanRedirects.js && wrangler deploy",
    "deploy:cron": "node scripts/deploy-doc-expiry-cron.mjs",
    "deploy:functions": "node scripts/deploy-edge-functions.mjs",
    "deploy:all": "npm run deploy:functions && npm run deploy:cron && npm run deploy",
    "email:write": "node scripts/write-auth-email-templates.mjs",
    "email:smtp": "node scripts/deploy-auth-smtp.mjs",
    "email:deploy": "node scripts/write-auth-email-templates.mjs && node scripts/deploy-auth-email-templates.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.119.0"
  }
}
