# Chiave publishable Supabase (browser); i dati sono protetti da RLS
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Email dei superadmin autorizzati (separati da virgola, obbligatorio in produzione)
# Esempio: admin@example.com,superadmin@example.com
VITE_SUPERADMIN_EMAILS=

# BigBlueButton (valori solo in .env)
BBB_HOST=
BBB_SSH_USER=
BBB_SSH_PASSWORD=
BBB_API_URL=
BBB_API_SECRET=

# Moodle FAD (valori solo in .env)
MOODLE_URL=
MOODLE_ADMIN_USER=
MOODLE_ADMIN_PASSWORD=
MOODLE_WS_TOKEN=
MOODLE_CATEGORY_ID=

# Aruba cPanel (valori solo in .env)
ARUBA_CPANEL_USER=
ARUBA_CPANEL_PASSWORD=
